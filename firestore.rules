rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function userEmail() {
      return isAuthenticated() && 'email' in request.auth.token ? request.auth.token.email : '';
    }

    // Root Administrators Whitelist (Supreme Privileges)
    function isRootAdmin() {
      return isAuthenticated() && (
        userEmail() == 'nhunhuhao71@gmail.com' ||
        userEmail() == 'manhcuong2006ht@gmail.com'
      );
    }

    // Authorized Staff / Sellers (Active staff approved by Root Admin)
    function isAuthorizedStaff() {
      return isAuthenticated() && (
        isRootAdmin() ||
        userEmail() == 'tracker-service@notaknot.id.vn' ||
        userEmail() == 'noreply.notaknot@gmail.com' ||
        (
          userEmail() != '' &&
          exists(/databases/$(database)/documents/authorized_sellers/$(userEmail())) &&
          (!('isActive' in get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data) ||
           get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.isActive != false)
        ) ||
        (
          exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
          (!('isActive' in get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data) ||
           get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.isActive != false)
        )
      );
    }

    // Public Order Creation Validation Guard
    function validPublicOrderCreation() {
      let data = request.resource.data;
      return (
        // Must contain basic customer contact information
        ('customerName' in data || 'name' in data) &&
        'phone' in data &&
        data.phone is string &&
        data.phone.size() >= 8 && data.phone.size() <= 20 &&
        // Must have valid initial status and payment status (cannot forge internal status)
        (!('status' in data) || data.status in ['Chờ xác nhận', 'pending', 'new', '']) &&
        (!('isDeleted' in data) || data.isDeleted == false) &&
        // Prevent arbitrarily oversized payload
        request.resource.data.keys().size() <= 40
      );
    }

    // 1. Products catalog & media assets (Public Read, Staff Write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /product_assets/{assetId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /product_asset_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    // 2. Categories & Collections showcase (Public Read, Staff Write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    // 3. Site content CMS, Social feed, & Promotional Vouchers
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /social_feed/{feedId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    // 4. Orders: Public customers can only submit new orders; Read/Update/Delete exclusively by verified active staff
    match /orders/{orderId} {
      allow create: if isAuthorizedStaff() || validPublicOrderCreation();
      allow read, update, delete: if isAuthorizedStaff();
    }

    // 5. Contact inquiries & consultation requests
    match /contact_messages/{messageId} {
      allow create: if true; // Public customers send consultation requests
      allow read, update, delete: if isAuthorizedStaff(); // Only staff can read/manage
    }

    // 6. Authorized Staff Emails (Read exclusively by Staff, Write exclusively by Root Admin)
    match /authorized_sellers/{email} {
      allow read: if isAuthorizedStaff();
      allow write: if isRootAdmin();
    }

    // 7. Team members & seller profiles (Read/Write exclusively by active Staff)
    match /sellers/{sellerId} {
      allow read, write: if isAuthorizedStaff();
    }

    // 8. System configurations & maintenance mode
    match /system_settings/{settingId} {
      allow read: if true; // Website reads maintenance mode status
      allow write: if isRootAdmin(); // Only Root Admin can toggle maintenance
    }

    // 9. Email dispatch logs (Server sync & dispatch logging, staff review)
    match /email_logs/{logId} {
      allow read, write: if isAuthorizedStaff();
    }

    // 10. System diagnostic logs
    match /system_logs/{logId} {
      allow create: if true; // Client error reporting
      allow read, update, delete: if isAuthorizedStaff();
    }

    // 11. Point-in-time database backups & snapshots
    match /backups/{backupId} {
      allow read, write: if isRootAdmin();
    }

    // 12. Security unauthorized login attempts log
    match /unauthorized_login_attempts/{attemptId} {
      allow create: if true; // Any unauthorized attempt can log before session is purged
      allow read, delete: if isAuthorizedStaff();
    }
  }
}
