rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Validation helper functions
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 &&
             data.price is number && data.price >= 0;
    }

    function isValidOrder(data) {
      return (data.name is string || data.customerName is string) &&
             (data.name.size() > 0 || data.customerName.size() > 0);
    }

    function isValidContactMessage(data) {
      return data.name is string && data.name.size() > 0 &&
             data.message is string && data.message.size() > 0 &&
             data.message.size() < 10000;
    }

    // Products collection: public read, validated write
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Product image assets collection (uncompressed high-res images & options)
    match /product_assets/{assetId} {
      allow read: if true;
      allow write: if true;
    }

    // Auto-chunked large assets (>1MB) sub-collection
    match /product_asset_chunks/{chunkId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: public create with validation, read/update/delete for order tracking & store management
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrder(request.resource.data);
      allow update, delete: if true;
    }

    // Categories collection: public read, write for admin/store catalog
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Collections & Banners collection: public read, write for admin
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if true;
    }

    // Site Content and customizable elements config: public read, write for admin
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if true;
    }

    // Vouchers collection: read for validation in checkout, write/manage by admin
    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact messages collection: public create with validation, read/update/delete for admin
    match /contact_messages/{messageId} {
      allow read: if true;
      allow create: if isValidContactMessage(request.resource.data);
      allow update, delete: if true;
    }

    // Sellers & Admin team members collection
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if true;
    }

    // Backups collection for Version History
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Health / Connection test documents
    match /test/{testId} {
      allow read, write: if true;
    }

    // Catch-all fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

