rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function userEmail() {
      return isAuthenticated() && 'email' in request.auth.token && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    // Root Administrators Whitelist (Supreme Privileges)
    function isRootAdmin() {
      return isAuthenticated() && (
        (userEmail() != '' && (
          userEmail() == 'nhunhuhao71@gmail.com' ||
          userEmail() == 'manhcuong2006ht@gmail.com'
        )) ||
        (request.auth.token.get('email', '') != '' && (
          request.auth.token.email == 'nhunhuhao71@gmail.com' ||
          request.auth.token.email == 'manhcuong2006ht@gmail.com' ||
          request.auth.token.email.lower() == 'nhunhuhao71@gmail.com' ||
          request.auth.token.email.lower() == 'manhcuong2006ht@gmail.com'
        ))
      );
    }

    function isStaffRole(data) {
      return data.get('isActive', true) != false &&
        data.get('role', 'member') in ['root_admin', 'deputy_admin', 'member'] &&
        data.get('role', '') != 'affiliate';
    }

    function isAffiliateRole(data) {
      return data.get('isActive', true) != false &&
        data.get('role', '') == 'affiliate';
    }

    // Authorized Staff / Sellers (Active staff only — strictly excludes affiliate accounts)
    function isAuthorizedStaff() {
      return isAuthenticated() && (
        isRootAdmin() ||
        userEmail() == 'tracker-service@notaknot.id.vn' ||
        userEmail() == 'noreply.notaknot@gmail.com' ||
        (
          userEmail() != '' &&
          exists(/databases/$(database)/documents/authorized_sellers/$(userEmail())) &&
          isStaffRole(get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data) &&
          (
            get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('sellerId', '') == '' ||
            !exists(/databases/$(database)/documents/sellers/$(get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('sellerId', ''))) ||
            isStaffRole(get(/databases/$(database)/documents/sellers/$(get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('sellerId', '')).data)
          )
        ) ||
        (
          exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
          isStaffRole(get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data)
        ) ||
        (
          userEmail() != '' &&
          exists(/databases/$(database)/documents/sellers/$( 'seller-' + request.auth.uid )) &&
          isStaffRole(get(/databases/$(database)/documents/sellers/$( 'seller-' + request.auth.uid )).data)
        )
      );
    }

    // Active Affiliate Partner (Approved & active affiliate account)
    function isActiveAffiliate() {
      return isAuthenticated() && !isAuthorizedStaff() && (
        (
          userEmail() != '' &&
          exists(/databases/$(database)/documents/authorized_sellers/$(userEmail())) &&
          isAffiliateRole(get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data) &&
          (
            get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('sellerId', '') == '' ||
            !exists(/databases/$(database)/documents/sellers/$(get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('sellerId', ''))) ||
            isAffiliateRole(get(/databases/$(database)/documents/sellers/$(get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('sellerId', '')).data)
          )
        ) ||
        (
          exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
          isAffiliateRole(get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data)
        )
      );
    }

    function currentAffiliateSellerId() {
      return userEmail() != '' &&
        exists(/databases/$(database)/documents/authorized_sellers/$(userEmail())) &&
        'sellerId' in get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data
        ? get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.sellerId
        : '';
    }

    function currentAffiliateCodeFromAuthDoc() {
      return userEmail() != '' &&
        exists(/databases/$(database)/documents/authorized_sellers/$(userEmail())) &&
        'affiliateCode' in get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data
        ? get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.affiliateCode
        : '';
    }

    function currentAffiliateCodeFromSellerDoc() {
      return currentAffiliateSellerId() != '' &&
        exists(/databases/$(database)/documents/sellers/$(currentAffiliateSellerId())) &&
        'affiliateCode' in get(/databases/$(database)/documents/sellers/$(currentAffiliateSellerId())).data
        ? get(/databases/$(database)/documents/sellers/$(currentAffiliateSellerId())).data.affiliateCode
        : (
          exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
          'affiliateCode' in get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data
            ? get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.affiliateCode
            : ''
        );
    }

    function isOwnAffiliateOrder() {
      return isActiveAffiliate() && (
        (currentAffiliateCodeFromAuthDoc() != '' && resource.data.affiliateCode == currentAffiliateCodeFromAuthDoc()) ||
        (currentAffiliateCodeFromSellerDoc() != '' && resource.data.affiliateCode == currentAffiliateCodeFromSellerDoc()) ||
        resource.data.affiliateId == request.auth.uid ||
        (currentAffiliateSellerId() != '' && resource.data.affiliateId == currentAffiliateSellerId())
      );
    }

    function isOwnAffiliateClick() {
      return isActiveAffiliate() && (
        (currentAffiliateCodeFromAuthDoc() != '' && resource.data.code == currentAffiliateCodeFromAuthDoc()) ||
        (currentAffiliateCodeFromSellerDoc() != '' && resource.data.code == currentAffiliateCodeFromSellerDoc())
      );
    }

    function isOwnSellerDoc(sellerId) {
      return isAuthenticated() && (
        sellerId == request.auth.uid ||
        (currentAffiliateSellerId() != '' && sellerId == currentAffiliateSellerId()) ||
        (
          resource != null && (
            resource.data.get('googleUid', '') == request.auth.uid ||
            (userEmail() != '' && resource.data.get('googleEmail', '') == userEmail()) ||
            (userEmail() != '' && resource.data.get('email', '') == userEmail())
          )
        )
      );
    }

    function canAffiliateUpdateOwnProfile(sellerId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthenticated() &&
        !isAuthorizedStaff() &&
        resource != null &&
        isOwnSellerDoc(sellerId) &&
        resource.data.get('isActive', true) != false &&
        resource.data.get('role', '') == 'affiliate' &&
        (
          userEmail() == '' ||
          !exists(/databases/$(database)/documents/authorized_sellers/$(userEmail())) ||
          isAffiliateRole(get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data)
        ) &&
        changedKeys.hasOnly(['name', 'phone', 'paymentInfo', 'paymentAccount', 'googleUid', 'linkedGoogleAt', 'updatedAt']) &&
        request.resource.data.get('role', '') == 'affiliate' &&
        request.resource.data.get('isRootAdmin', false) == false &&
        request.resource.data.get('isActive', true) == resource.data.get('isActive', true) &&
        request.resource.data.get('affiliateCode', '') == resource.data.get('affiliateCode', '') &&
        request.resource.data.get('googleEmail', '') == resource.data.get('googleEmail', '') &&
        request.resource.data.get('email', '') == resource.data.get('email', '') &&
        request.resource.data.get('username', '') == resource.data.get('username', '') &&
        (
          !('googleUid' in changedKeys) || (
            (resource.data.get('googleUid', '') == '' || resource.data.get('googleUid', '') == request.auth.uid) &&
            request.resource.data.get('googleUid', '') == request.auth.uid
          )
        ) &&
        request.resource.data.get('name', '') is string &&
        request.resource.data.get('name', '').size() > 0 &&
        request.resource.data.get('name', '').size() <= 120 &&
        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30)) &&
        (!('paymentInfo' in request.resource.data) || (request.resource.data.paymentInfo is string && request.resource.data.paymentInfo.size() <= 500)) &&
        (!('paymentAccount' in request.resource.data) || request.resource.data.paymentAccount is map);
    }

    function canStaffWriteSellerDoc(sellerId) {
      return isRootAdmin() || (
        isAuthorizedStaff() && (
          // Staff can create/update affiliate partner profiles, but never grant staff/admin roles
          (
            request.resource.data.get('role', '') == 'affiliate' &&
            request.resource.data.get('isRootAdmin', false) == false &&
            (resource == null || resource.data.get('role', '') == 'affiliate')
          ) ||
          // Staff can update their own profile/presence without changing role, root status, or active status
          (
            resource != null &&
            isOwnSellerDoc(sellerId) &&
            resource.data.get('role', 'member') in ['deputy_admin', 'member'] &&
            request.resource.data.get('role', 'member') == resource.data.get('role', 'member') &&
            request.resource.data.get('isRootAdmin', false) == false &&
            request.resource.data.get('isActive', true) == resource.data.get('isActive', true)
          )
        )
      );
    }

    // Order Security Guard: Enforces strict initial status, paymentStatus, and paidAmount
    // Only approved staff with a verified Firebase email can record commission payouts.
    function canRecordAffiliateCommissionPayment() {
      return isAuthenticated() && request.auth.token.get('email_verified', false) && (
        isRootAdmin() || (
          userEmail() != '' &&
          exists(/databases/$(database)/documents/authorized_sellers/$(userEmail())) &&
          get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('role', '') in ['deputy_admin', 'member'] &&
          get(/databases/$(database)/documents/authorized_sellers/$(userEmail())).data.get('isActive', true) != false
        )
      );
    }

    function validInitialAffiliateCommissionPayment() {
      let data = request.resource.data;
      return data.get('affiliateCommissionPaid', false) == false &&
        data.get('affiliateCommissionPaidAmount', 0) == 0 &&
        data.get('affiliateCommissionPaidAt', '') == '' &&
        data.get('affiliateCommissionPaidBy', '') == '';
    }

    function affiliateCommissionPaymentUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'affiliateCommissionPaid', 'affiliateCommissionPaidAmount', 'affiliateCommissionPaidAt', 'affiliateCommissionPaidBy'
      ]);
    }

    function validPublicOrderCreation() {
      let data = request.resource.data;
      return (
        // Must contain basic customer contact information
        ('customerName' in data || 'name' in data) &&
        'phone' in data &&
        data.phone is string &&
        data.phone.size() >= 8 && data.phone.size() <= 20 &&
        // Strict enforcement: Initial status MUST be 'Chờ xác nhận'
        (!('status' in data) || data.status == 'Chờ xác nhận') &&
        // Strict enforcement: Initial payment status MUST be 'unpaid'
        (!('paymentStatus' in data) || data.paymentStatus == 'unpaid') &&
        // Strict enforcement: Initial paid amount MUST be 0
        (!('paidAmount' in data) || data.paidAmount == 0) &&
        (!('isDeleted' in data) || data.isDeleted == false) &&
        // Prevent arbitrarily oversized payload
        request.resource.data.keys().size() <= 40
      );
    }

    // 1. Products catalog & media assets (Public Read, Staff Write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /product_assets/{assetId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /product_asset_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    // 2. Categories & Collections showcase (Public Read, Staff Write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    // 3. Site content CMS, Social feed, & Promotional Vouchers
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /social_feed/{feedId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isAuthorizedStaff();
    }

    // 4. Orders:
    // Staff can create, read, update, and delete any order.
    // Affiliates can ONLY read orders attributed to their own affiliateCode/affiliateId, and cannot modify/delete orders.
    // Customers can submit new orders with strict initial status enforcement ('Chờ xác nhận', 'unpaid', paidAmount = 0).
    match /orders/{orderId} {
      allow create: if (isAuthorizedStaff() || validPublicOrderCreation()) && (canRecordAffiliateCommissionPayment() || validInitialAffiliateCommissionPayment());
      allow get: if isAuthorizedStaff() || isOwnAffiliateOrder();
      allow list: if isAuthorizedStaff() || (
        isAuthenticated() && (
          (currentAffiliateCodeFromAuthDoc() != '' && resource.data.affiliateCode == currentAffiliateCodeFromAuthDoc()) ||
          (currentAffiliateCodeFromSellerDoc() != '' && resource.data.affiliateCode == currentAffiliateCodeFromSellerDoc()) ||
          resource.data.affiliateId == request.auth.uid ||
          (currentAffiliateSellerId() != '' && resource.data.affiliateId == currentAffiliateSellerId())
        )
      );
      allow update: if isAuthorizedStaff() && (canRecordAffiliateCommissionPayment() || affiliateCommissionPaymentUnchanged());
      allow delete: if isAuthorizedStaff();
    }

    // 5. Contact inquiries & consultation requests
    match /contact_messages/{messageId} {
      allow create: if true; // Public customers send consultation requests
      allow read, update, delete: if isAuthorizedStaff(); // Only staff can read/manage
    }

    // 6. Authorized Staff & Affiliate Emails
    // Staff can read all; an authenticated user can only get their own email record.
    // Root Admin can write any; Staff can only sync affiliate entries (never grant/change staff roles).
    match /authorized_sellers/{email} {
      allow get: if isAuthorizedStaff() || (isAuthenticated() && userEmail() != '' && userEmail() == email);
      allow list: if isAuthorizedStaff();
      allow create, update: if isRootAdmin() || (
        isAuthorizedStaff() &&
        request.resource.data.get('role', '') == 'affiliate' &&
        request.resource.data.get('isRootAdmin', false) == false &&
        (resource == null || resource.data.get('role', '') == 'affiliate')
      );
      allow delete: if isRootAdmin();
    }

    // 7. Team members & affiliate profiles
    // Staff can read all; an affiliate can only read their own active profile.
    // Affiliates can only update their own allowed personal fields (name, phone, paymentInfo, paymentAccount).
    match /sellers/{sellerId} {
      allow get: if isAuthorizedStaff() || (isOwnSellerDoc(sellerId) && (resource == null || resource.data.get('isActive', true) != false));
      allow list: if isAuthorizedStaff() || isAuthenticated();
      allow create: if canStaffWriteSellerDoc(sellerId);
      allow update: if canStaffWriteSellerDoc(sellerId) || canAffiliateUpdateOwnProfile(sellerId);
      allow delete: if isRootAdmin();
    }

    // 8. System configurations & maintenance mode
    match /system_settings/{settingId} {
      allow read: if true; // Website reads maintenance mode & affiliate default config
      allow write: if isRootAdmin() || (settingId == 'affiliate_config' && isAuthorizedStaff());
    }

    // 9. Email dispatch logs (Server sync & dispatch logging, staff review)
    match /email_logs/{logId} {
      allow read, write: if isAuthorizedStaff();
    }

    // 10. System diagnostic logs
    match /system_logs/{logId} {
      allow create: if true; // Client error reporting
      allow read, update, delete: if isAuthorizedStaff();
    }

    // 11. Point-in-time database backups & snapshots
    match /backups/{backupId} {
      allow read, write: if isAuthorizedStaff();
    }

    // 12. Security unauthorized login attempts log
    match /unauthorized_login_attempts/{attemptId} {
      allow create: if true; // Any unauthorized attempt can log before session is purged
      allow read, delete: if isAuthorizedStaff();
    }

    // 13. Customer uploaded custom photos
    match /uploaded_custom_photos/{photoId} {
      allow create, update, read: if true;
      allow delete: if isAuthorizedStaff();
    }

    // 14. Affiliate link click tracking
    match /affiliate_clicks/{clickId} {
      allow create: if true;
      allow read: if isAuthorizedStaff() || isOwnAffiliateClick();
      allow update, delete: if isAuthorizedStaff();
    }
  }
}
