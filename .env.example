# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# SMTP: Required for real order-confirmation delivery.
# For Gmail, use an App Password stored in the deployment secret manager.
# Never commit the real password to this file or the repository.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NOT A KNOT <noreply.notaknot@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=

# VITE_BACKEND_URL: Optional API server URL when hosting frontend separately (e.g. GitHub Pages calling Cloud Run/Render/Vercel backend)
VITE_BACKEND_URL=

# CDN & Asset Delivery (Cloudflare, AWS CloudFront, BunnyCDN, Fastly)
# Example: https://cdn.notaknot.id.vn
VITE_CDN_URL=
# Example: https://images.weserv.nl/ or Cloudflare Images endpoint
VITE_CDN_IMAGE_SERVICE=
