{
  "entities": {
    "Product": {
      "description": "Danh sách sản phẩm phụ kiện thủ công Paracord và EDC của NOT A KNOT",
      "fields": {
        "id": { "type": "string", "description": "Mã định danh sản phẩm" },
        "name": { "type": "string", "description": "Tên sản phẩm" },
        "category": { "type": "string", "description": "Danh mục sản phẩm" },
        "price": { "type": "number", "description": "Giá bán sản phẩm" },
        "originalPrice": { "type": "number", "description": "Giá niêm yết cũ", "optional": true },
        "discountBadge": { "type": "string", "description": "Huy hiệu giảm giá", "optional": true },
        "image": { "type": "string", "description": "URL hoặc Data URL ảnh sản phẩm" },
