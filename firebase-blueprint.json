        "timestamp": { "type": "number", "description": "Thời gian Unix timestamp" },
        "isRead": { "type": "boolean", "description": "Trạng thái đã đọc hay chưa", "optional": true },
        "status": { "type": "string", "description": "Trạng thái tin nhắn (unread, read, replied)", "optional": true }
      }
    },
    "Seller": {
