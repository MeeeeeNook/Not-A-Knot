        "order": { "type": "number", "description": "Thứ tự sắp xếp hiển thị", "optional": true }
      }
    },
    "ContactMessage": {
      "description": "Tin nhắn và yêu cầu tư vấn từ khách hàng gửi qua biểu mẫu liên hệ",
      "fields": {
        "id": { "type": "string", "description": "Mã định danh tin nhắn" },
        "name": { "type": "string", "description": "Tên khách hàng" },
        "contactInfo": { "type": "string", "description": "Email hoặc số điện thoại / mạng xã hội" },
        "email": { "type": "string", "description": "Email khách hàng", "optional": true },
        "phone": { "type": "string", "description": "Số điện thoại khách hàng", "optional": true },
        "message": { "type": "string", "description": "Nội dung tin nhắn" },
