      "fields": {
        "id": { "type": "string", "description": "Mã định danh tài khoản" },
        "username": { "type": "string", "description": "Tên đăng nhập" },
        "name": { "type": "string", "description": "Họ và tên người bán" },
        "passwordHash": { "type": "string", "description": "Mật khẩu băm SHA-256" },
        "passwordSalt": { "type": "string", "description": "Muối mã hóa" },
        "isRootAdmin": { "type": "boolean", "description": "Quyền Admin Gốc" },
        "role": { "type": "string", "description": "Vai trò tài khoản (root_admin, manager, member)" },
        "isActive": { "type": "boolean", "description": "Trạng thái hoạt động" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" },
        "lastLoginAt": { "type": "string", "description": "Thời gian đăng nhập gần nhất", "optional": true },
        "avatarColor": { "type": "string", "description": "Màu đại diện avatar", "optional": true },
        "phone": { "type": "string", "description": "Số điện thoại", "optional": true }
      }
    },
    "EmailLog": {
      "description": "Nhật ký gửi email xác nhận đơn hàng và thông báo quản trị viên",
      "fields": {
        "id": { "type": "string", "description": "Mã định danh log" },
        "timestamp": { "type": "number", "description": "Thời gian Unix gửi email" },
        "recipient": { "type": "string", "description": "Địa chỉ email người nhận" },
        "orderCode": { "type": "string", "description": "Mã đơn hàng liên quan", "optional": true },
        "type": { "type": "string", "description": "Loại email (customer_confirmation, admin_notification, manual_admin, test)" },
        "status": { "type": "string", "description": "Trạng thái (sent, simulated, error)" },
        "createdAt": { "type": "string", "description": "Thời gian ISO" }
      }
    },
    "SystemSetting": {
      "description": "Cấu hình hệ thống bao gồm email và thông báo",
      "fields": {
        "id": { "type": "string", "description": "Mã cấu hình" },
        "notifyAdminOnNewOrder": { "type": "boolean", "description": "Bật/tắt email thông báo admin khi có đơn mới" },
        "customerOrderEmailOption": { "type": "boolean", "description": "Bật/tắt gửi email xác nhận cho khách" },
        "adminNotificationEmail": { "type": "string", "description": "Email nhận thông báo admin" },
        "smtpPass": { "type": "string", "description": "Mật khẩu ứng dụng SMTP (lưu bảo mật)", "optional": true },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/collections/{collectionId}": {
      "schema": "Collection",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/site_content/{contentId}": {
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/social_feed/{feedId}": {
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/sellers/{sellerId}": {
      "schema": "Seller",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/email_logs/{logId}": {
      "schema": "EmailLog",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSetting",
      "allow": {
        "read": "true",
        "write": "true"
      }
    }
  },
  "indexes": [
    { "collectionGroup": "orders", "fields": [{ "fieldPath": "status", "order": "ASCENDING" }, { "fieldPath": "createdAt", "order": "DESCENDING" }] },
    { "collectionGroup": "orders", "fields": [{ "fieldPath": "type", "order": "ASCENDING" }, { "fieldPath": "createdAt", "order": "DESCENDING" }] },
    { "collectionGroup": "orders", "fields": [{ "fieldPath": "phone", "order": "ASCENDING" }, { "fieldPath": "createdAt", "order": "DESCENDING" }] },
    { "collectionGroup": "products", "fields": [{ "fieldPath": "category", "order": "ASCENDING" }, { "fieldPath": "price", "order": "ASCENDING" }] },
    { "collectionGroup": "products", "fields": [{ "fieldPath": "category", "order": "ASCENDING" }, { "fieldPath": "inStock", "order": "ASCENDING" }, { "fieldPath": "price", "order": "ASCENDING" }] },
    { "collectionGroup": "products", "fields": [{ "fieldPath": "isBestSeller", "order": "ASCENDING" }, { "fieldPath": "price", "order": "ASCENDING" }] },
    { "collectionGroup": "contact_messages", "fields": [{ "fieldPath": "status", "order": "ASCENDING" }, { "fieldPath": "createdAt", "order": "DESCENDING" }] },
    { "collectionGroup": "email_logs", "fields": [{ "fieldPath": "type", "order": "ASCENDING" }, { "fieldPath": "timestamp", "order": "DESCENDING" }] }
  ]
}
